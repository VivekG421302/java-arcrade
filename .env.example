VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Optional: enables server push so the noon reminder arrives even when the app is closed
VITE_VAPID_PUBLIC_KEY=
# Optional: Java compiler backend (defaults to the public Judge0 CE instance)
VITE_JUDGE0_URL=https://ce.judge0.com
VITE_JAVA_LANG_ID=91
# Rust runner (Judge0 CE ids: 73 = Rust 1.40; use the id of a newer Rust on your own Judge0 for modern features)
VITE_RUST_LANG_ID=73
